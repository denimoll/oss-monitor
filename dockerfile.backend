FROM python:3.14.7-alpine3.24

# Create a dedicated non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Install Python deps first — maximises layer cache reuse
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Create the DB directory *inside the image* so a fresh named volume mounted
# here inherits appuser ownership. Without this Docker creates the mount point
# as root:root and the non-root process cannot write the SQLite file at all.
RUN mkdir -p /app/db_data \
 && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
